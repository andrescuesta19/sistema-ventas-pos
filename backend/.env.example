# Server Configuration
PORT=3000

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Email SMTP Credentials (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# === Seguridad ===
# Habilita el endpoint /api/auth/registro (crear locales + admins nuevos).
# Por defecto false. Solo true durante el bootstrap inicial.
ALLOW_REGISTRATION=false

# Token requerido en header X-Bootstrap-Token cuando ALLOW_REGISTRATION=true.
# Generar con: openssl rand -hex 32
BOOTSTRAP_TOKEN=
