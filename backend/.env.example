# =====================================================
# PLANTILLA PÚBLICA - NO incluye secretos reales
# Copia este archivo como .env (que está en .gitignore)
# y completa los valores con tus credenciales reales.
# =====================================================

# Server
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASS@HOST/DBNAME?sslmode=require

# JWT (genera con: openssl rand -hex 64)
JWT_SECRET=<REEMPLAZA_CON_SECRET_DE_64_HEX>
JWT_REFRESH_SECRET=<REEMPLAZA_CON_OTRO_SECRET_DIFERENTE>

# Encryption (genera con: openssl rand -hex 32)
ENCRYPTION_KEY=<REEMPLAZA_CON_SECRET_DE_32_HEX>

# Email SMTP (Gmail)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_16_caracteres

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu_secret

# Cloudinary (https://cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# Seguridad
ALLOW_REGISTRATION=false
BOOTSTRAP_TOKEN=
