# ⚠️ ESTE ES EL .env QUE SE EMPAQUETA EN LA APP
# NO debe contener credenciales reales. Solo placeholders.
# El usuario debe editarlo ANTES de hacer una venta real
# (para configurar su propia BD y su propio SMTP).

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Connection (Neon PostgreSQL)
# ⚠️ Reemplaza con tu propia connection string de Neon
#    Consigue una gratis en https://neon.tech
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Email SMTP Credentials (Gmail)
# ⚠️ Reemplaza con tu cuenta de Gmail + contraseña de aplicación
#    Genera una contraseña de app en https://myaccount.google.com/apppasswords
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password

# === Seguridad ===
# Registro público de nuevos locales/admins. Por defecto DESHABILITADO.
ALLOW_REGISTRATION=false

# Token de bootstrap si quieres permitir registros (opcional).
BOOTSTRAP_TOKEN=
