# Server Configuration
PORT=3000

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_2MvedAqOpKf9@ep-billowing-flower-atimh18c-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Email SMTP Credentials (Gmail)
EMAIL_USER=andrescuesta112@gmail.com
EMAIL_PASS=jrhx flul kowu sqzo

# === Seguridad ===
# Registro público de nuevos locales/admins (C2-fix). Por defecto DESHABILITADO.
# Solo habilitar para el primer despliegue. Luego volver a false.
ALLOW_REGISTRATION=false

# Si está definido, /api/auth/registro exige este token en el header X-Bootstrap-Token.
# Genera uno con: openssl rand -hex 32
BOOTSTRAP_TOKEN=

# Google OAuth (agregado v2.2.3)
GOOGLE_CLIENT_SECRET=<ROTATED>

# Cloudinary (v2.2.10) - Almacenamiento persistente de imágenes/videos
# Crear cuenta gratis en https://cloudinary.com → Dashboard → Credentials
CLOUDINARY_CLOUD_NAME=<ROTATED>
CLOUDINARY_API_KEY=<ROTATED>
CLOUDINARY_API_SECRET=<ROTATED>
CLOUDINARY_URL=<ROTATED>

# === JWT Secrets (v2.2.6) ===
# Generados una sola vez con openssl rand -hex 64. Se usan para firmar tokens.
# Si los cambias, todos los usuarios tendrán que volver a iniciar sesión.
JWT_SECRET=<ROTATED>
JWT_REFRESH_SECRET=<ROTATED>
