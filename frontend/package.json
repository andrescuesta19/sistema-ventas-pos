{
  "name": "sistema-ventas-pos",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "main": "electron.cjs",
  "author": "Andrés Cuesta",
  "description": "Sistema Integral de Ventas - Punto de Venta POS",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-version.cjs && node scripts/auto-commit.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && ELECTRON_DEV=true electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:portable": "npm run build && electron-builder --win portable --x64",
    "electron:build:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.andrescuesta.pos",
    "productName": "Sistema de Ventas POS",
    "copyright": "Copyright © 2026 Andrés Cuesta",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "public/logos/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!pos_database.sqlite",
          "!.env",
          "!node_modules/**/test/**",
          "!node_modules/**/tests/**",
          "!node_modules/**/.bin"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "maximum",
    "icon": "build/icon",
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Sistema de Ventas POS ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Andrés Cuesta",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema de Ventas POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/icon.ico",
      "license": "build/LICENSE.txt"
    },
    "portable": {
      "artifactName": "SistemaVentasPOS-Portable-${version}.${ext}"
    },
    "fileAssociations": [],
    "publish": [
      {
        "provider": "github",
        "owner": "andrescuesta19",
        "repo": "sistema-ventas-pos",
        "channel": "latest"
      }
    ]
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.0.0",
    "wait-on": "^8.0.2"
  }
}
